# Godot 4+ specific ignores
.godot/
/android/

# Export directory: ignore everything inside it except what the Xcode project needs to build
# (Xcode Cloud builds straight from these committed files).
# Note: use /export/* (not /export/) so the ! exceptions below can take effect.
/export/*
!/export/solitaireslasher.xcodeproj/
!/export/solitaireslasher/
!/export/solitaireslasher.pck
!/export/PrivacyInfo.xcprivacy
!/export/MoltenVK.xcframework/
!/export/solitaireslasher.xcframework/
!/export/ExportOptions.plist
!/export/DistributionSummary.plist

# Per-user Xcode state and macOS clutter
xcuserdata/
.DS_Store

# Build outputs
*.ipa
*.xcarchive/

# libgodot.a is stored with Git LFS (see /.gitattributes); never add new copies outside it
/export/**/libgodot.a
